  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "digest"
        ],
        "title": "Approval"
      },
      "AvailabilityRequest": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "available"
        ],
        "title": "AvailabilityRequest"
      },
      "BusinessFields": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "maxLength": 180,
            "title": "Category",
            "default": ""
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "title": "Location",
            "default": ""
          },
          "hours": {
            "type": "string",
            "maxLength": 180,
            "title": "Hours",
            "default": ""
          },
          "phone": {
            "type": "string",
            "maxLength": 40,
            "title": "Phone",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "BusinessFields"
      },
      "ChallengeRequest": {
        "properties": {
          "business_id": {
            "type": "string",
            "title": "Business Id"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "business_id",
          "consent"
        ],
        "title": "ChallengeRequest"
      },
      "CoachTurn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3}$",
            "title": "Language",
            "default": "en"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "business_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "CoachTurn"
      },
      "ConsentRequest": {
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Version"
          },
          "terms": {
            "type": "boolean",
            "title": "Terms"
          },
          "privacy": {
            "type": "boolean",
            "title": "Privacy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "terms",
          "privacy"
        ],
        "title": "ConsentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProductFields": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Name"
          },
          "price": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Price",
            "description": "INR paise; integer, never a float"
          },
          "unit": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Unit",
            "default": "item"
          },
          "stock": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stock"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "price"
        ],
        "title": "ProductFields"
      },
      "ProposalRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^(business|inventory)$",
            "title": "Kind"
          },
          "business_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
