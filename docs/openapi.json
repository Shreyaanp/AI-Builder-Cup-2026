{
  "openapi": "3.1.0",
  "info": {
    "title": "oGoogle AI streaming API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap": {
      "get": {
        "summary": "Bootstrap",
        "operationId": "bootstrap_api_v1_bootstrap_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Bootstrap Api V1 Bootstrap Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/coach/stream": {
      "post": {
        "summary": "Coach Stream",
        "operationId": "coach_stream_api_v1_coach_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachTurn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE frames containing StreamEvent JSON; not a JSON document.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoachTurn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "hi"
            ],
            "title": "Language",
            "default": "en"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "CoachTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "StreamEvent": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "ready",
              "delta",
              "reply",
              "turn_complete",
              "error",
              "interrupted",
              "input_transcript",
              "output_transcript",
              "audio_format",
              "pong"
            ],
            "title": "Kind",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Session Id"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Code"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "offline",
                  "gemini"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mode"
          },
          "sample_rate": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sample Rate"
          }
        },
        "required": [
          "kind"
        ],
        "title": "StreamEvent",
        "type": "object"
      },
      "VoiceControl": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "text",
              "audio_end",
              "close",
              "ping"
            ],
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "default": "",
            "maxLength": 2000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "VoiceControl",
        "type": "object"
      }
    }
  }
}
