{
  "name": "ogoogle-ai-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node scripts/backend-dev.mjs",
    "theme:generate": "node scripts/generate-material.mjs",
    "prebuild": "npm run theme:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test:ui": "playwright test",
    "test:hooks": "node scripts/check-hook-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run build && npm run test:hooks && npm run test:ui",
    "test:qa": "playwright test -c tests/qa/playwright.config.ts",
    "graph": "uv run --no-project --python 3.13 --with graphifyy==0.9.89 python scripts/build_graph.py",
    "impact": "uv run --no-project --python 3.13 python scripts/impact.py"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/google-sans-flex": "5.3.1",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@mui/material": "^9.5.0",
    "firebase": "^13.0.0",
    "gsap": "3.15.0",
    "lucide-react": "^1.56.0",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
