# No key is required for offline streaming and tests.
APP_ENV=local
COACH_MODE=offline
AUTH_MODE=local
SESSION_DATABASE_URL=sqlite+aiosqlite:///./data/sessions.sqlite3
ALLOWED_ORIGINS=["http://127.0.0.1:3200","http://localhost:3200"]

# Live mode is opt-in. Set COACH_MODE=gemini and provide both supported model IDs.
# Verify model access and billing/free-tier eligibility before starting a live request.
GOOGLE_API_KEY=
GOOGLE_TEXT_MODEL=
GOOGLE_LIVE_MODEL=
GOOGLE_CLOUD_PROJECT=

# Cloud mode requires Firebase auth, a durable session database and a stable cookie secret.
SESSION_SIGNING_SECRET=
MAX_TURN_SECONDS=30
MAX_VOICE_SECONDS=120
MAX_ACTIVE_RUNS=8
SESSION_BACKEND=sqlite
FIRESTORE_DATABASE=(default)
FIRESTORE_NAMESPACE=ogoogle_ai_v1
FRONTEND_DIST=
# Firebase browser configuration is separate from the private Gemini API key.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=

# Instant path: common owner requests answered by rules before any model call (default on).
INSTANT_PATH_ENABLED=true
# Vertex embeddings of known intents for paraphrases (read-only/navigation only; default off).
INSTANT_EMBEDDINGS=false
# Vertex context caching of the coach rules + tool schemas (text coach; default off).
CONTEXT_CACHE_ENABLED=false
CONTEXT_CACHE_TTL_SECONDS=1800
